---
import {
  ShieldAlert,
  Copy,
  Check,
  ArrowRight,
  ShieldCheck,
  ExternalLink,
  AlertTriangle,
  Eye,
  UserX,
  UserCheck,
} from "lucide-astro";
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <!-- Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-rose-500/10 border border-rose-500/25 mb-6 backdrop-blur-md">
          <span class="flex h-2 w-2 rounded-full bg-rose-500 animate-ping"></span>
          <span class="text-xs font-semibold text-rose-300 font-mono tracking-wide uppercase">
            Autonomous Discord Defense
          </span>
          <span class="text-zinc-600">|</span>
          <span class="text-xs text-zinc-300">Powered by Turso & Groq</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.08] mb-6">
          Stop phishing before <br class="hidden sm:inline" />
          it spreads. <br />
          <span class="bg-gradient-to-r from-rose-400 via-rose-500 to-amber-300 bg-clip-text text-transparent">
            Protect every channel.
          </span>
        </h1>

        <!-- Subheadline -->
        <p class="text-base sm:text-lg text-zinc-300 max-w-2xl font-normal leading-relaxed mb-8">
          Tsubaki intercepts zero-day malicious links across message bodies, rich embeds, and
          attachment metadata before members can click. Packed with decentralized Turso blocklist
          syncing, forensic quarantine, and an anime AI companion that brightens your server.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto mb-10">
          <a
            href="#deploy"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 text-sm font-semibold text-white bg-gradient-to-r from-rose-600 via-rose-600 to-rose-700 hover:from-rose-500 hover:to-rose-600 rounded-xl shadow-xl shadow-rose-950/60 hover:shadow-rose-900/80 transition-all border border-rose-400/40 hover:-translate-y-0.5"
          >
            <span>Deploy to Render / Self-Host</span>
            <ArrowRight class="w-4 h-4" />
          </a>

          <a
            href="https://github.com/GaseousIce/Tsubaki"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-semibold text-zinc-200 bg-[#12151F] hover:bg-[#1A1F2D] border border-white/10 hover:border-white/20 rounded-xl transition-all hover:-translate-y-0.5"
          >
            <span>View Source on GitHub</span>
            <ExternalLink class="w-4 h-4 text-zinc-400" />
          </a>
        </div>

        <!-- Quick Terminal Pill -->
        <div class="w-full sm:max-w-md bg-[#0D0F16] border border-white/10 rounded-xl p-3 flex items-center justify-between gap-3 font-mono text-xs text-zinc-300 shadow-inner group">
          <div class="flex items-center gap-2 overflow-x-auto whitespace-nowrap scrollbar-none">
            <span class="text-rose-400 select-none">$</span>
            <span class="text-zinc-200 select-all">
              git clone https://github.com/GaseousIce/Tsubaki.git
            </span>
          </div>
          <button
            id="copy-clone-btn"
            type="button"
            class="p-1.5 text-zinc-400 hover:text-white rounded-md hover:bg-white/5 transition-colors shrink-0"
            title="Copy command"
          >
            <Copy class="w-3.5 h-3.5" id="copy-icon" />
            <Check class="w-3.5 h-3.5 text-emerald-400 hidden" id="copied-icon" />
          </button>
        </div>

        <!-- Metric Badges Row -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-10 border-t border-white/5 w-full mt-10">
          <div>
            <div class="text-2xl sm:text-3xl font-bold font-mono text-white tracking-tight">
              &lt; 50ms
            </div>
            <div class="text-xs text-zinc-400 mt-1">Interception Speed</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-bold font-mono text-rose-400 tracking-tight">
              100%
            </div>
            <div class="text-xs text-zinc-400 mt-1">Pre-Spread Lockdown</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-bold font-mono text-white tracking-tight">
              Turso
            </div>
            <div class="text-xs text-zinc-400 mt-1">Global libSQL Sync</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-bold font-mono text-amber-300 tracking-tight">
              Groq
            </div>
            <div class="text-xs text-zinc-400 mt-1">Ultra-Fast Anime AI</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Discord Threat Interception Simulation -->
      <div class="lg:col-span-5 relative">
        <!-- Background decorative glow -->
        <div class="absolute -inset-1 bg-gradient-to-r from-rose-600/30 via-rose-900/10 to-indigo-600/20 rounded-2xl blur-xl opacity-75"></div>

        <div class="relative rounded-2xl bg-[#11131C] border border-white/10 shadow-2xl overflow-hidden font-discord">
          <!-- Discord Channel Header -->
          <div class="bg-[#0C0E15] px-4 py-3 border-b border-white/5 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-zinc-500 font-semibold text-lg">#</span>
              <span class="text-sm font-semibold text-white tracking-wide">mod-logs-alerts</span>
              <span class="text-[11px] px-2 py-0.5 rounded bg-rose-500/15 text-rose-300 border border-rose-500/30 font-mono">
                LIVE INTERCEPTION
              </span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span class="text-xs text-zinc-400 font-mono">Synced</span>
            </div>
          </div>

          <!-- Simulation Body -->
          <div class="p-4 sm:p-5 space-y-4 text-xs sm:text-sm">
            <!-- Step 1: Malicious message intercepted banner -->
            <div class="p-2.5 rounded-lg bg-red-950/40 border border-red-500/30 flex items-start gap-2.5">
              <AlertTriangle class="w-4 h-4 text-rose-400 shrink-0 mt-0.5" />
              <div class="flex-1 text-xs">
                <span class="font-semibold text-rose-300">Threat Quarantined:</span>
                <span class="text-zinc-300">
                  {" "}
                  Compromised account posted typosquatted scam link. Message removed within 42ms.
                </span>
              </div>
            </div>

            <!-- Step 2: Mod Alert Embed with Interactive Action Buttons -->
            <div class="rounded-lg bg-[#181B26] border-l-4 border-l-rose-500 border border-white/5 p-4 space-y-3 shadow-lg">
              <!-- Embed Header -->
              <div class="flex items-center gap-2">
                <div class="w-6 h-6 rounded-full bg-rose-600/20 flex items-center justify-center text-rose-400">
                  <ShieldAlert class="w-3.5 h-3.5" />
                </div>
                <div class="font-bold text-white text-sm">
                  🛡️ Anti-Phishing Alert — Threat Neutralized
                </div>
              </div>

              <!-- Embed Details Fields -->
              <div class="space-y-1.5 text-xs text-zinc-300">
                <div>
                  <span class="text-zinc-400">Target Member:</span>
                  <span class="text-rose-300 font-semibold ml-1">@AlexVault (`#1337`)</span>
                </div>
                <div>
                  <span class="text-zinc-400">Detected Link:</span>
                  <code class="ml-1 px-1.5 py-0.5 bg-black/50 text-rose-400 rounded font-mono text-[11px]">
                    https://cliscord-nitro.app/gift/claim
                  </code>
                </div>
                <div>
                  <span class="text-zinc-400">Detection Vector:</span>
                  <span class="text-amber-300 font-medium ml-1">
                    Typosquat heuristic + Turso global blocklist
                  </span>
                </div>
                <div>
                  <span class="text-zinc-400">Automated Action:</span>
                  <span class="inline-flex items-center gap-1 ml-1 px-2 py-0.5 rounded bg-rose-500/20 text-rose-200 font-semibold text-[11px]">
                    Timed Out (7 Days)
                  </span>
                </div>
              </div>

              <!-- Message Preview in Safe Block -->
              <div class="space-y-1">
                <div class="text-[11px] font-semibold text-zinc-400 uppercase tracking-wider">
                  Neutralized Message Payload:
                </div>
                <div class="bg-[#0D0F16] p-2.5 rounded border border-white/5 font-mono text-[11px] text-zinc-300 select-all break-all">
                  ``` Free Nitro 3 months event! Click now to link your Steam profile:
                  https://cliscord-nitro.app/gift/claim ```
                </div>
              </div>

              <!-- Recovery DM Dispatch Notice -->
              <div class="text-[11px] text-emerald-400/90 flex items-center gap-1.5 bg-emerald-950/20 border border-emerald-500/20 p-2 rounded">
                <ShieldCheck class="w-3.5 h-3.5 shrink-0" />
                <span>
                  Security DM automatically dispatched to user with 5-step token reset instructions.
                </span>
              </div>

              <!-- Interactive Moderator Action Buttons (exact buttons from Tsubaki code) -->
              <div class="pt-2 border-t border-white/5">
                <div class="text-[10px] text-zinc-400 uppercase tracking-wider mb-2 font-mono">
                  Moderator Action Controls (Role-Hierarchy Protected)
                </div>
                <div class="flex flex-wrap gap-2">
                  <button
                    type="button"
                    class="px-3 py-1.5 text-xs font-medium rounded bg-[#31374A] hover:bg-[#3D455D] text-white transition-all flex items-center gap-1.5 border border-white/10"
                    title="Remove timeout and whitelist member"
                  >
                    <UserCheck class="w-3 h-3 text-emerald-400" />
                    <span>Pardon User</span>
                  </button>
                  <button
                    type="button"
                    class="px-3 py-1.5 text-xs font-medium rounded bg-rose-600/80 hover:bg-rose-600 text-white transition-all flex items-center gap-1.5 border border-rose-500/30"
                    title="Permanently ban the compromised account"
                  >
                    <UserX class="w-3 h-3" />
                    <span>Ban User</span>
                  </button>
                  <button
                    type="button"
                    class="px-3 py-1.5 text-xs font-medium rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 transition-all flex items-center gap-1.5 border border-white/10"
                    title="Add domain to safe whitelist"
                  >
                    <Eye class="w-3 h-3 text-sky-400" />
                    <span>Allow URL</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Tsubaki Bot Stamp -->
            <div class="flex items-center justify-between text-[11px] text-zinc-400 px-1 font-mono">
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                Tsubaki v1.0.0
              </span>
              <span>Turso Cluster ID: libsql-us-east</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById("copy-clone-btn");
  const copyIcon = document.getElementById("copy-icon");
  const copiedIcon = document.getElementById("copied-icon");

  if (copyBtn && copyIcon && copiedIcon) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText("git clone https://github.com/GaseousIce/Tsubaki.git");
        copyIcon.classList.add("hidden");
        copiedIcon.classList.remove("hidden");
        setTimeout(() => {
          copyIcon.classList.remove("hidden");
          copiedIcon.classList.add("hidden");
        }, 2000);
      } catch (e) {
        console.error("Failed to copy", e);
      }
    });
  }
</script>
