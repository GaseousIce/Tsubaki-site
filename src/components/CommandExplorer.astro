                      #security-alerts
                    </span>
                  </div>
                  <div>
                    <span class="text-zinc-400 block font-semibold text-[11px]">Mod Roles</span>
                    <span class="text-indigo-300 font-mono bg-indigo-950/40 px-2 py-0.5 rounded border border-indigo-500/20 inline-block mt-0.5">
