                    Used{" "}
                    <code class="text-amber-400 font-mono">/test message_id:1284920491823</code>
                  </div>
                </div>
              </div>

              <div class="rounded-lg bg-[#181B26] border-l-4 border-l-amber-500 border border-white/5 p-4 space-y-3">
                <div class="font-bold text-white text-sm flex items-center gap-2">
                  🧪 Test Log — Message Threat Inspection
                </div>
                <div class="text-xs text-zinc-300 space-y-1">
