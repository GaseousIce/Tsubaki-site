                  https://steamcommunlty.ru/gift
                  <br />
                  ```
                </div>
              </div>
            </div>

            <!-- Output 3: /setup -->
            <div id="view-setup" class="cmd-view hidden space-y-4">
              <div class="flex items-center gap-3">
                <img
                  src="/favicon.svg"
