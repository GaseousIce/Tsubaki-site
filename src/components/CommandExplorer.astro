---
import { Shield, Trash2, CheckCircle2, Sliders, BarChart3, Bot } from "lucide-astro";
---

<section
  id="commands"
  class="py-24 relative overflow-hidden bg-[#090B10]/80 border-t border-white/5"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-300 text-xs font-mono font-semibold uppercase tracking-wider mb-4">
        Interactive Command Catalog
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
        Precision slash commands <br class="hidden sm:inline" />
        built for moderators
      </h2>
      <p class="mt-4 text-base sm:text-lg text-zinc-300">
        Every command is role-gated, permission-checked, and synced seamlessly with Discord's slash
        command tree.
      </p>
    </div>

    <!-- Command Explorer Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left: Interactive Command Tabs -->
      <div class="lg:col-span-5 flex flex-col gap-2.5">
        <!-- Tab: /antiphishing settings -->
        <button
          type="button"
          data-tab="settings"
          class="cmd-tab active w-full text-left p-4 rounded-xl border border-rose-500/40 bg-[#161924] hover:bg-[#1C2030] transition-all flex items-start gap-4 group"
        >
          <div class="p-2.5 rounded-lg bg-rose-500/20 text-rose-400 shrink-0">
            <Sliders class="w-5 h-5" />
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between">
              <span class="font-mono text-sm font-bold text-white group-hover:text-rose-300 transition-colors">
                /antiphishing settings
              </span>
              <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-rose-950/80 text-rose-300 border border-rose-500/30">
                Admin
              </span>
            </div>
            <p class="text-xs text-zinc-400 mt-1 line-clamp-1">
              Interactive dashboard for action, duration, roles & alert routing.
            </p>
          </div>
        </button>

        <!-- Tab: /test -->
        <button
          type="button"
          data-tab="test"
          class="cmd-tab w-full text-left p-4 rounded-xl border border-white/5 bg-[#0F121B] hover:bg-[#161924] transition-all flex items-start gap-4 group"
        >
          <div class="p-2.5 rounded-lg bg-amber-500/10 text-amber-400 shrink-0">
            <Shield class="w-5 h-5" />
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between">
              <span class="font-mono text-sm font-bold text-white group-hover:text-amber-300 transition-colors">
                /test &lt;message_id&gt;
              </span>
              <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-amber-950/80 text-amber-300 border border-amber-500/30">
                Manage Msg
              </span>
            </div>
            <p class="text-xs text-zinc-400 mt-1 line-clamp-1">
              Non-destructive sandbox to inspect threats and review attachments.
            </p>
          </div>
        </button>

        <!-- Tab: /setup -->
        <button
          type="button"
          data-tab="setup"
          class="cmd-tab w-full text-left p-4 rounded-xl border border-white/5 bg-[#0F121B] hover:bg-[#161924] transition-all flex items-start gap-4 group"
        >
          <div class="p-2.5 rounded-lg bg-emerald-500/10 text-emerald-400 shrink-0">
            <CheckCircle2 class="w-5 h-5" />
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between">
              <span class="font-mono text-sm font-bold text-white group-hover:text-emerald-300 transition-colors">
                /setup
              </span>
              <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-emerald-950/80 text-emerald-300 border border-emerald-500/30">
                Admin
              </span>
            </div>
            <p class="text-xs text-zinc-400 mt-1 line-clamp-1">
              Full server healthcheck verifying DB, feeds, roles & permissions.
            </p>
          </div>
        </button>

        <!-- Tab: /antiphishing stats -->
        <button
          type="button"
          data-tab="stats"
          class="cmd-tab w-full text-left p-4 rounded-xl border border-white/5 bg-[#0F121B] hover:bg-[#161924] transition-all flex items-start gap-4 group"
        >
          <div class="p-2.5 rounded-lg bg-sky-500/10 text-sky-400 shrink-0">
            <BarChart3 class="w-5 h-5" />
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between">
              <span class="font-mono text-sm font-bold text-white group-hover:text-sky-300 transition-colors">
                /antiphishing stats
              </span>
              <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-sky-950/80 text-sky-300 border border-sky-500/30">
                Admin
              </span>
            </div>
            <p class="text-xs text-zinc-400 mt-1 line-clamp-1">
              Detection totals, blocked domain rankings, and latest incident log.
            </p>
          </div>
        </button>

        <!-- Tab: /clear -->
        <button
          type="button"
          data-tab="clear"
          class="cmd-tab w-full text-left p-4 rounded-xl border border-white/5 bg-[#0F121B] hover:bg-[#161924] transition-all flex items-start gap-4 group"
        >
          <div class="p-2.5 rounded-lg bg-purple-500/10 text-purple-400 shrink-0">
            <Trash2 class="w-5 h-5" />
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between">
              <span class="font-mono text-sm font-bold text-white group-hover:text-purple-300 transition-colors">
                /clear [limit] [user] [bots_only]
              </span>
              <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-purple-950/80 text-purple-300 border border-purple-500/30">
                Manage Msg
              </span>
            </div>
            <p class="text-xs text-zinc-400 mt-1 line-clamp-1">
              Bulk channel prune with filter options and bot-only wiping.
            </p>
          </div>
        </button>

        <!-- Tab: /ask -->
        <button
          type="button"
          data-tab="ask"
          class="cmd-tab w-full text-left p-4 rounded-xl border border-white/5 bg-[#0F121B] hover:bg-[#161924] transition-all flex items-start gap-4 group"
        >
          <div class="p-2.5 rounded-lg bg-pink-500/10 text-pink-400 shrink-0">
            <Bot class="w-5 h-5" />
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between">
              <span class="font-mono text-sm font-bold text-white group-hover:text-pink-300 transition-colors">
