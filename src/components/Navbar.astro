---
import { Github, Menu, X, Rocket } from "lucide-astro";
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[#07080C]/80 border-b border-white/5 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="#" class="flex items-center gap-3 group">
      <div class="relative w-10 h-10 rounded-xl bg-gradient-to-br from-[#E11D48] to-[#9F1239] p-0.5 shadow-lg shadow-[#E11D48]/20 group-hover:shadow-[#E11D48]/40 transition-all duration-300">
        <div class="w-full h-full bg-[#0D0F17] rounded-[10px] flex items-center justify-center overflow-hidden">
          <img
            src="/favicon.svg"
            alt="Tsubaki Emblem"
            class="w-7 h-7 transform group-hover:scale-110 transition-transform duration-300"
          />
        </div>
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="text-xl font-bold tracking-tight text-white group-hover:text-rose-400 transition-colors">
            Tsubaki
          </span>
          <span class="text-[10px] tracking-wider font-semibold uppercase px-2 py-0.5 rounded-full bg-rose-500/10 text-rose-400 border border-rose-500/20">
            椿
          </span>
        </div>
        <span class="text-[11px] text-zinc-400 font-mono tracking-tight flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          AutoMod & Phishing Defense
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      <a
        href="#features"
        class="text-sm font-medium text-zinc-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/5 transition-all"
      >
        Features
      </a>
      <a
        href="#defense-pipeline"
        class="text-sm font-medium text-zinc-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/5 transition-all"
      >
        Defense Pipeline
      </a>
      <a
        href="#commands"
        class="text-sm font-medium text-zinc-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/5 transition-all"
      >
        Slash Commands
      </a>
      <a
        href="#interactive-demo"
        class="text-sm font-medium text-zinc-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/5 transition-all"
      >
        Live Simulator
      </a>
      <a
        href="#deploy"
        class="text-sm font-medium text-zinc-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/5 transition-all"
      >
        Self-Hosting
      </a>
      <a
        href="#faq"
        class="text-sm font-medium text-zinc-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/5 transition-all"
      >
        FAQ
      </a>
    </nav>

    <!-- Desktop Action Buttons -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="https://github.com/GaseousIce/Tsubaki"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-zinc-200 bg-zinc-900/80 hover:bg-zinc-800 border border-white/10 hover:border-white/20 rounded-xl transition-all shadow-sm"
      >
        <Github class="w-4 h-4" />
        <span>GitHub</span>
      </a>
      <a
        href="#deploy"
        class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-gradient-to-r from-rose-600 to-rose-700 hover:from-rose-500 hover:to-rose-600 rounded-xl shadow-lg shadow-rose-900/40 hover:shadow-rose-700/50 transition-all border border-rose-400/30"
      >
        <Rocket class="w-3.5 h-3.5" />
        <span>Deploy Bot</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      aria-label="Toggle Navigation"
      class="md:hidden p-2 text-zinc-400 hover:text-white hover:bg-white/5 rounded-xl border border-white/10"
    >
      <Menu class="w-5 h-5" id="menu-icon-open" />
      <X class="w-5 h-5 hidden" id="menu-icon-close" />
    </button>
  </div>

  <!-- Mobile Dropdown -->
  <div
    id="mobile-menu"
    class="hidden md:hidden px-4 pt-2 pb-6 border-b border-white/10 bg-[#0B0D13]"
  >
    <div class="flex flex-col space-y-2">
      <a
        href="#features"
        class="px-3 py-2 text-sm text-zinc-300 hover:text-white rounded-lg hover:bg-white/5"
      >
        Features
      </a>
      <a
        href="#defense-pipeline"
        class="px-3 py-2 text-sm text-zinc-300 hover:text-white rounded-lg hover:bg-white/5"
      >
        Defense Pipeline
      </a>
      <a
        href="#commands"
        class="px-3 py-2 text-sm text-zinc-300 hover:text-white rounded-lg hover:bg-white/5"
      >
        Slash Commands
      </a>
      <a
        href="#interactive-demo"
        class="px-3 py-2 text-sm text-zinc-300 hover:text-white rounded-lg hover:bg-white/5"
      >
        Live Simulator
      </a>
      <a
        href="#deploy"
        class="px-3 py-2 text-sm text-zinc-300 hover:text-white rounded-lg hover:bg-white/5"
      >
        Self-Hosting
      </a>
      <a
        href="#faq"
        class="px-3 py-2 text-sm text-zinc-300 hover:text-white rounded-lg hover:bg-white/5"
      >
        FAQ
      </a>
      <div class="pt-3 flex flex-col gap-2">
        <a
          href="https://github.com/GaseousIce/Tsubaki"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 py-2.5 text-xs font-semibold text-zinc-200 bg-zinc-900 rounded-xl border border-white/10"
        >
          <Github class="w-4 h-4" />
          <span>Star on GitHub</span>
        </a>
        <a
          href="#deploy"
          class="flex items-center justify-center gap-2 py-2.5 text-xs font-semibold text-white bg-rose-600 rounded-xl shadow-md"
        >
          <Rocket class="w-3.5 h-3.5" />
          <span>Quickstart Deployment</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-icon-open");
  const closeIcon = document.getElementById("menu-icon-close");

  if (toggleBtn && mobileMenu && openIcon && closeIcon) {
    toggleBtn.addEventListener("click", () => {
      const isExpanded = !mobileMenu.classList.contains("hidden");
      if (isExpanded) {
        mobileMenu.classList.add("hidden");
        openIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");
      } else {
        mobileMenu.classList.remove("hidden");
        openIcon.classList.add("hidden");
        closeIcon.classList.remove("hidden");
      }
    });

    // Close on link click
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
        openIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");
      });
    });
  }
</script>
