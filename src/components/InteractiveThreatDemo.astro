---
import { Play } from "lucide-astro";
---

<section id="interactive-demo" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-300 text-xs font-mono font-semibold uppercase tracking-wider mb-4">
        Live Threat Interception Sandbox
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
        Test Tsubaki's detection engine <br class="hidden sm:inline" />
        directly in your browser
      </h2>
      <p class="mt-4 text-base sm:text-lg text-zinc-300">
        Simulate incoming message threats, verify typosquat heuristics, and watch the forensic alert
        generate in real time.
      </p>
    </div>

    <!-- Simulator Shell -->
    <div class="max-w-4xl mx-auto rounded-2xl bg-[#0D0F17] border border-white/10 shadow-2xl p-6 sm:p-8 relative">
      <!-- Glow background -->
      <div class="absolute -top-20 -right-20 w-72 h-72 bg-rose-600/10 blur-[100px] pointer-events-none rounded-full"></div>

      <!-- Presets Selector -->
      <div class="mb-6">
        <label class="block text-xs font-mono uppercase text-zinc-400 mb-2">
          Select sample threat scenario or enter custom text:
        </label>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            class="preset-btn px-3 py-1.5 rounded-lg text-xs font-mono bg-white/5 hover:bg-white/10 text-zinc-200 border border-white/10 transition-colors"
            data-sample="Free Nitro 3 months event! Click now: https://cliscord-nitro.app/gift/claim"
            data-type="threat-discord"
          >
            Fake Discord Nitro Link
          </button>
          <button
            type="button"
            class="preset-btn px-3 py-1.5 rounded-lg text-xs font-mono bg-white/5 hover:bg-white/10 text-zinc-200 border border-white/10 transition-colors"
            data-sample="Check out this CS2 trade offer bro: https://steamcommunlty.ru/trade/offer/3910"
            data-type="threat-steam"
          >
            Steam Phishing Homoglyph
          </button>
          <button
            type="button"
            class="preset-btn px-3 py-1.5 rounded-lg text-xs font-mono bg-white/5 hover:bg-white/10 text-zinc-200 border border-white/10 transition-colors"
            data-sample="Here is the open source repo for the project: https://github.com/GaseousIce/Tsubaki"
            data-type="safe"
          >
            Legitimate GitHub URL
          </button>
        </div>
      </div>

      <!-- Input Bar -->
      <div class="space-y-3 mb-8">
        <div class="relative">
          <textarea
            id="sim-input"
            rows="3"
            class="w-full bg-[#141724] border border-white/10 focus:border-rose-500/50 rounded-xl p-3.5 text-xs sm:text-sm font-mono text-white placeholder-zinc-500 focus:outline-none focus:ring-1 focus:ring-rose-500/50 transition-all resize-none"
            placeholder="Type or paste a message containing URLs to analyze..."
          >Free Nitro 3 months event! Click now: https://cliscord-nitro.app/gift/claim</textarea>
        </div>

        <div class="flex items-center justify-between">
          <div class="text-xs text-zinc-500 font-mono">
            Analyzed via regex extraction + blacklist feeds + typosquats
          </div>
          <button
            id="sim-run-btn"
            type="button"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-rose-600 to-rose-700 hover:from-rose-500 hover:to-rose-600 text-white font-semibold text-xs shadow-lg shadow-rose-950/60 transition-all"
          >
            <Play class="w-3.5 h-3.5 fill-current" />
            <span>Simulate Interception</span>
          </button>
        </div>
      </div>

      <!-- Results Display -->
      <div
        id="sim-result-container"
        class="rounded-xl bg-[#111420] border border-white/10 p-5 font-discord"
      >
        <!-- Will be updated dynamically by JS -->
        <div class="flex items-center justify-between border-b border-white/5 pb-3 mb-4">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span>
            <span class="text-sm font-bold text-white" id="result-status-title">
              THREAT NEUTRALIZED (Latency: 38ms)
            </span>
          </div>
          <span
            class="px-2.5 py-0.5 rounded bg-rose-500/20 text-rose-300 font-mono text-[11px] font-semibold"
            id="result-badge"
          >
            PUNISHED &bull; TIMEOUT 7D
          </span>
        </div>

        <!-- Rendered Discord Alert Card -->
        <div
          class="rounded-lg bg-[#181B26] border-l-4 border-l-rose-500 border border-white/5 p-4 space-y-3"
          id="result-embed-box"
        >
          <div class="text-xs space-y-1.5 text-zinc-300">
            <div>
              <span class="text-zinc-400">Target User:</span>
              <span class="text-white font-medium ml-1">@DemoUser (`1092837482`)</span>
            </div>
            <div>
              <span class="text-zinc-400">Extracted URL:</span>
              <code
                class="ml-1 text-rose-400 font-mono bg-black/40 px-1.5 py-0.5 rounded"
                id="result-url"
              >
                https://cliscord-nitro.app/gift/claim
              </code>
            </div>
            <div>
              <span class="text-zinc-400">Detection Match:</span>
              <span class="text-amber-300 font-medium ml-1" id="result-match">
                Typosquat Heuristic match against official Discord phishing feed
              </span>
            </div>
            <div>
              <span class="text-zinc-400">Quarantine Action:</span>
              <span class="text-rose-200 font-medium ml-1" id="result-action">
                Message deleted, user timed out for 7 days, recovery DM dispatched.
              </span>
            </div>
          </div>

          <div class="mt-3 pt-3 border-t border-white/5">
            <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-wider mb-2">
              Safe Quarantine Log Preview:
            </div>
            <pre
              class="bg-[#0B0D13] p-2.5 rounded text-zinc-300 font-mono text-xs overflow-x-auto whitespace-pre-wrap"
              id="result-codeblock"
            >```
Free Nitro 3 months event! Click now: https://cliscord-nitro.app/gift/claim
```</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const simInput = document.getElementById("sim-input") as HTMLTextAreaElement | null;
  const runBtn = document.getElementById("sim-run-btn");
  const presetBtns = document.querySelectorAll(".preset-btn");

  const statusTitle = document.getElementById("result-status-title");
  const badge = document.getElementById("result-badge");
  const urlEl = document.getElementById("result-url");
  const matchEl = document.getElementById("result-match");
  const actionEl = document.getElementById("result-action");
  const codeblockEl = document.getElementById("result-codeblock");
  const embedBox = document.getElementById("result-embed-box");

  // Presets click handler
  presetBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const sample = btn.getAttribute("data-sample") || "";
      if (simInput) {
        simInput.value = sample;
        analyzeText(sample);
      }
    });
  });

  if (runBtn && simInput) {
    runBtn.addEventListener("click", () => {
      analyzeText(simInput.value);
    });
  }

  function analyzeText(text: string) {
    if (!statusTitle || !badge || !urlEl || !matchEl || !actionEl || !codeblockEl || !embedBox)
      return;

    // Check for threats
    const lower = text.toLowerCase();
    const isPhish =
      lower.includes("nitro") ||
      lower.includes("steam") ||
      lower.includes("cliscord") ||
      lower.includes("communlty") ||
      lower.includes(".ru") ||
      lower.includes(".xyz") ||
      lower.includes(".gift") ||
      lower.includes(".app");

    if (isPhish && (text.includes("http://") || text.includes("https://"))) {
      // Threat detected
      const extracted = text.match(/https?:\/\/[^\s]+/)?.[0] || "https://suspicious-domain.com";
      const randomLatency = Math.floor(Math.random() * 20) + 32;

      statusTitle.textContent = `THREAT NEUTRALIZED (Latency: ${randomLatency}ms)`;
      statusTitle.className = "text-sm font-bold text-white";
      badge.textContent = "PUNISHED • TIMEOUT 7D";
      badge.className =
        "px-2.5 py-0.5 rounded bg-rose-500/20 text-rose-300 font-mono text-[11px] font-semibold";

      embedBox.className =
        "rounded-lg bg-[#181B26] border-l-4 border-l-rose-500 border border-white/5 p-4 space-y-3";
      urlEl.textContent = extracted;
      urlEl.className = "ml-1 text-rose-400 font-mono bg-black/40 px-1.5 py-0.5 rounded";
      matchEl.textContent = "Matched high-confidence typosquat & Turso global threat index";
      matchEl.className = "text-amber-300 font-medium ml-1";
      actionEl.textContent =
        "Message deleted in 40ms, user timed out for 7 days, recovery security DM sent.";
      codeblockEl.textContent = "```\n" + text + "\n```";
    } else {
      // Clean / Safe URL
      const extracted = text.match(/https?:\/\/[^\s]+/)?.[0] || "(No URLs detected)";
      statusTitle.textContent = "INSPECTION CLEAN (Latency: 18ms)";
      statusTitle.className = "text-sm font-bold text-emerald-400";
      badge.textContent = "VERIFIED • CLEAN";
      badge.className =
        "px-2.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono text-[11px] font-semibold";

      embedBox.className =
        "rounded-lg bg-[#181B26] border-l-4 border-l-emerald-500 border border-white/5 p-4 space-y-3";
      urlEl.textContent = extracted;
      urlEl.className = "ml-1 text-emerald-400 font-mono bg-black/40 px-1.5 py-0.5 rounded";
      matchEl.textContent =
        "Passed all official lists, typosquats, and rate checks. Zero threats detected.";
      matchEl.className = "text-emerald-300 font-medium ml-1";
      actionEl.textContent = "No action necessary. Message passed through safely.";
      codeblockEl.textContent = text;
    }
  }
</script>
